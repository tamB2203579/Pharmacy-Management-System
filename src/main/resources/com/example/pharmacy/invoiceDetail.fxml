<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: white; -fx-border-color: #c85f77; -fx-border-width: 2;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pharmacy.InvoiceDetailController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Invoice Details" textFill="#c85f77">
         <font>
            <Font name="Arial Bold" size="24.0" />
         </font>
      </Label>
      <Label fx:id="invoiceIdLabel" layoutX="20.0" layoutY="55.0" text="Invoice ID: " textFill="#333333">
         <font>
            <Font name="Arial" size="14.0" />
         </font>
      </Label>
      <Label fx:id="customerNameLabel" layoutX="200.0" layoutY="55.0" text="Customer: " textFill="#333333">
         <font>
            <Font name="Arial" size="14.0" />
         </font>
      </Label>
      <Label fx:id="staffNameLabel" layoutX="400.0" layoutY="55.0" text="Staff: " textFill="#333333">
         <font>
            <Font name="Arial" size="14.0" />
         </font>
      </Label>
      <Label fx:id="totalLabel" layoutX="20.0" layoutY="80.0" text="Total: " textFill="#333333">
         <font>
            <Font name="Arial" size="14.0" />
         </font>
      </Label>
      <Label fx:id="dateLabel" layoutX="200.0" layoutY="80.0" text="Date: " textFill="#333333">
         <font>
            <Font name="Arial" size="14.0" />
         </font>
      </Label>
      <TableView fx:id="detailTableView" layoutX="20.0" layoutY="120.0" prefHeight="300.0" prefWidth="660.0" style="-fx-border-color: #ddd; -fx-border-width: 1;">
        <columns>
          <TableColumn fx:id="col_medicineId" prefWidth="100.0" text="Medicine ID" />
          <TableColumn fx:id="col_productName" prefWidth="150.0" text="Product Name" />
            <TableColumn fx:id="col_category" prefWidth="120.0" text="Category" />
            <TableColumn fx:id="col_quantity" prefWidth="80.0" text="Quantity" />
            <TableColumn fx:id="col_unitPrice" prefWidth="100.0" text="Unit Price" />
            <TableColumn fx:id="col_totalPrice" prefWidth="110.0" text="Total Price" />
        </columns>
      </TableView>
      <Button fx:id="closeButton" layoutX="600.0" layoutY="450.0" mnemonicParsing="false" onAction="#closeModal" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #c85f77; -fx-text-fill: white; -fx-font-weight: bold;" text="Close">
         <font>
            <Font name="Arial" size="12.0" />
         </font>
      </Button>
      <Button fx:id="printButton" layoutX="500.0" layoutY="450.0" mnemonicParsing="false" onAction="#printInvoice" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Print">
         <font>
            <Font name="Arial" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
